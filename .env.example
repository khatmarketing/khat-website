# Public site configuration
NEXT_PUBLIC_SITE_URL=https://khatmarketing.ir

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Headless WordPress CMS
# Use the REST root URL, usually https://cms.example.com
WORDPRESS_API_URL=https://admin.khatmarketing.ir
WORDPRESS_ADMIN_URL=https://admin.khatmarketing.ir/wp-admin
WORDPRESS_MEDIA_HOST=admin.khatmarketing.ir
WORDPRESS_REVALIDATE_SECONDS=300

# WordPress Application Password credentials for server-side form/media forwarding.
# Never use a real administrator password here. Create a restricted application user.
WORDPRESS_APPLICATION_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

# Optional fallback notification webhook for contact submissions.
CONTACT_WEBHOOK_URL=

# Monitoring
SENTRY_DSN=

# Contact destinations are owner-approved constants in src/lib/contact.ts.
